<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Wyświetlanie panelu nad innymi aplikacjami (użytkownik przyznaje ręcznie). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Opcjonalne: wykrywanie aplikacji na ekranie (auto-ukrywanie paska). Przyznawane ręcznie w "Dostęp do danych o użyciu". -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Widoczność aplikacji z ikoną w launcherze: ikona odtwarzacza (Slim) i otwieranie aplikacji. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".MusicBarApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SzczurMediaBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Serwis nasłuchu powiadomień: daje dostęp do aktywnych sesji multimedialnych
            (YouTube Music itd.) i jednocześnie hostuje nakładkę. System sam go podpina
            po restarcie telefonu, więc BOOT_COMPLETED nie jest potrzebny.
        -->
        <service
            android:name=".media.MusicNotificationListener"
            android:exported="true"
            android:label="@string/listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Kafelek szybkich ustawień: ukryj / pokaż pasek. -->
        <service
            android:name=".tile.MusicBarTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
